\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ncd-style}[2026/11/18 New Concept Danish Textbook Style]

% Page geometry
\RequirePackage[a4paper, top=2.1cm, bottom=2.1cm, left=2.0cm, right=2.0cm, headheight=16pt]{geometry}

% Prevent TeX from stretching vertical gaps on partially filled pages
\raggedbottom

% Font configuration (Charis SIL covers Danish letters + full IPA glyphs)
\RequirePackage{fontspec}
\setmainfont{Charis SIL}
\setsansfont{Noto Sans}
\setmonofont{DejaVu Sans Mono}
\newfontfamily\ipafont{Charis SIL}

% Colors
\RequirePackage[table,dvipsnames,svgnames]{xcolor}
\definecolor{NCDNavy}{HTML}{1B365D}
\definecolor{NCDRed}{HTML}{C8102E}
\definecolor{NCDTeal}{HTML}{006D77}
\definecolor{NCDGold}{HTML}{B45309}
\definecolor{NCDGray}{HTML}{475569}
\definecolor{NCDBgBlue}{HTML}{F0F4F8}
\definecolor{NCDBgRed}{HTML}{FDF2F4}
\definecolor{NCDBgTeal}{HTML}{F0F9F9}
\definecolor{NCDBgGold}{HTML}{FFFBEB}
\definecolor{NCDBgGray}{HTML}{F8FAFC}

% Tables, lists, typography & boxes
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{xltabular}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{pifont}
\RequirePackage{fancyhdr}
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins,breakable}

% Longtable defaults (full-width flush, minimal vertical gap)
\setlength{\LTleft}{0pt}
\setlength{\LTright}{0pt}
\setlength{\LTpre}{0.4em}
\setlength{\LTpost}{0.4em}

% Bookmarks & links (load near end)
\RequirePackage[
  bookmarks=true,
  bookmarksnumbered=true,
  bookmarksopen=true,
  colorlinks=true,
  linkcolor=NCDNavy,
  urlcolor=NCDRed,
  citecolor=NCDNavy
]{hyperref}

% Chinese + section styling via ctex
\ctexset{
  part/format = {\centering\Huge\bfseries\color{NCDNavy}},
  section/format = {\Large\bfseries\color{NCDNavy}},
  subsection/format = {\large\bfseries\color{NCDTeal}},
  subsubsection/format = {\normalsize\bfseries\color{NCDGray}}
}

% Paragraph & list spacing
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.4em}
\setlist[itemize]{leftmargin=1.5em, itemsep=0.22em, topsep=0.22em}
\setlist[enumerate]{leftmargin=1.6em, itemsep=0.25em, topsep=0.25em}

% Header & footer
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{NCDGray}\textit{Ny Koncept Dansk}\ ·\ 新概念丹麦语}
\fancyhead[R]{\small\color{NCDGray}\nouppercase{\leftmark}}
\fancyfoot[C]{\small\color{NCDGray}-- \thepage\ --}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

% Semantic inline helpers
\newcommand{\ipa}[1]{{\ipafont\textcolor{NCDGold}{[#1]}}}
\newcommand{\da}[1]{\textbf{\textcolor{NCDNavy}{#1}}}
\newcommand{\dabold}[1]{\textbf{\textcolor{NCDRed}{#1}}}
\newcommand{\badge}[2]{\colorbox{#1}{\textcolor{white}{\footnotesize\bfseries\sffamily #2}}}

% Track whether a unit banner was just rendered so the first lesson starts right below it
\newif\if@afterunit
\@afterunitfalse

% Compact top-of-page Unit Banner macro (no wasted blank page)
% Usage: \ncdunit{1}{Danish Unit Title}{Chinese Unit Title}{Lesson summary}
\newcommand{\ncdunit}[4]{%
  \clearpage
  \phantomsection
  \addcontentsline{toc}{part}{Unit #1: #3}%
  \markboth{Unit #1: #2}{Unit #1: #2}%
  \begin{tcolorbox}[
    enhanced,
    colback=NCDBgRed,
    colframe=NCDRed,
    boxrule=0.8pt,
    arc=3pt,
    left=10pt, right=10pt, top=7pt, bottom=7pt,
    borderline west={4pt}{0pt}{NCDRed}
  ]
    {\small\bfseries\color{NCDRed} UNIT #1} \quad {\large\bfseries\color{NCDNavy} #2} \quad {\normalsize\bfseries\color{NCDTeal}（#3）}\\[2pt]
    {\small\color{NCDGray} #4}
  \end{tcolorbox}
  \global\@afterunittrue
}

% Lesson header macro: starts new page unless immediately following \ncdunit
% Usage: \ncdlesson{1}{Danish Title}{Chinese Title}{Alignment}{Grammar Targets}{Study Tips}
\newcommand{\ncdlesson}[6]{%
  \if@afterunit
    \global\@afterunitfalse
    \vspace{0.3em}
  \else
    \clearpage
  \fi
  \phantomsection
  \addcontentsline{toc}{section}{Lektion #1: #2（#3）}%
  \markboth{Lektion #1: #2}{Lektion #1: #2}%
  \begin{tcolorbox}[
    enhanced,
    breakable,
    colback=NCDBgBlue,
    colframe=NCDNavy,
    boxrule=1pt,
    arc=3pt,
    left=10pt, right=10pt, top=8pt, bottom=8pt,
    borderline north={3pt}{0pt}{NCDRed}
  ]
    {\LARGE\bfseries\color{NCDNavy} Lektion #1:\ #2}\\[3pt]
    {\large\bfseries\color{NCDGray} #3}\\[5pt]
    \rule{\linewidth}{0.4pt}\\[4pt]
    \small
    \textbf{\color{NCDRed}[定位与考点]}\ #4\\[2pt]
    \textbf{\color{NCDNavy}[核心语法靶点]}\ #5\\[2pt]
    \textbf{\color{NCDTeal}[备考与学习策略]}\ #6
  \end{tcolorbox}
  \vspace{0.25em}
}

% Subsection inside a lesson (adds bookmark under the lesson without duplicate numbering)
\newcommand{\ncdsubsec}[1]{%
  \vspace{0.45em}
  \phantomsection
  \addcontentsline{toc}{subsection}{#1}%
  \subsection*{#1}%
}

% Dialogue turn macro (breakable across pages if needed)
% Usage: \dialogturn{1}{Emma}{Danish line}{Pronunciation note}{Chinese translation}
\newcommand{\dialogturn}[5]{%
  \begin{tcolorbox}[
    enhanced,
    breakable,
    blanker,
    left=1.6em,
    top=2pt, bottom=4pt,
    borderline west={1.5pt}{0pt}{NCDBgBlue}
  ]
    \hspace*{-1.5em}\textbf{\color{NCDRed}#1.}\ \textbf{\color{NCDNavy}#2:}\ \textit{\textbf{#3}}\\[2pt]
    \small\textcolor{NCDGray}{\badge{NCDGold}{语音}\ #4}\\[2pt]
    \small\textcolor{black}{\badge{NCDTeal}{译文}\ #5}
  \end{tcolorbox}
  \vspace{0.12em}
}

% Page-breakable Gloser vocabulary table (longtable with repeating headers)
\newenvironment{glosertable}{%
  \par\small
  \renewcommand{\arraystretch}{1.22}%
  \begin{longtable}{@{\extracolsep{\fill}} >{\leavevmode\bfseries\color{NCDGray}\raggedright\arraybackslash}p{1.9cm} >{\leavevmode\itshape\bfseries\color{NCDNavy}\raggedright\arraybackslash}p{3.15cm} >{\leavevmode\raggedright\arraybackslash}p{5.75cm} >{\leavevmode\raggedright\arraybackslash}p{4.7cm} @{}}
  \toprule
  \textbf{词性} & \textbf{丹麦语原形} & \textbf{完整屈折变化} & \textbf{中文释义} \\
  \midrule
  \endfirsthead
  \toprule
  \textbf{词性} & \textbf{丹麦语原形} & \textbf{完整屈折变化（续表）} & \textbf{中文释义} \\
  \midrule
  \endhead
  \bottomrule
  \endfoot
}{%
  \end{longtable}\par
}

